# ============================================================
# Gold Trading System - MIXED configuration (one-folder layout)
# NinjaTrader data (CME gold L1+L2) + AI decision + MT5 execution
# ============================================================

# ---------- DATA: NinjaTrader bridge ----------
# Live CME gold from the GoldBridgeExporter indicator's ticks.csv.
# Leave EMPTY to auto-detect: it finds ticks.csv in THIS SAME FOLDER first
# (set the indicator's "Output folder" in NinjaTrader to this folder -
#  see README_MIXED.md). Fallbacks: parent folder -> A:\gitHub\Rhitmic
#  -> C:\NinjaBridge.
DATA_SOURCE=ninjabridge
NT_BRIDGE_FILE=
# Data window kept in memory (seconds). v3: 8h (28800) unlocks the M15
# timeframe vote and the full Asian range; 2h (7200) gives M5 only.
# If the PC feels heavy during New York hours, 21600 (6h) still keeps M15.
NT_WINDOW_SECONDS=28800

# The futures contract on your NinjaTrader chart (root symbol matters)
DATA_SYMBOL=MGC 12-26

# ---------- EXECUTION: MT5 ----------
MT5_SYMBOL=XAUUSD
TRADING_SYMBOL=XAUUSD
BROKER_NAME=Pepperstone

# ============ PHASE 2: DRY RUN (safe default) ============
# 0 = analyse only, NEVER send an order.
# Flip to 1 ONLY for Phase 3 (demo trading) with MT5 open on the DEMO account.
TRADING_ENABLED=0
# Safety net: 0 = the bot refuses to trade if the MT5 terminal is logged into
# a REAL account (demo/contest always fine). Keep 0 until going live is a
# deliberate decision.
ALLOW_LIVE_TRADING=0

# Who may send orders: python (Step 4 via the MT5 SDK) | ea | none
EXECUTION_MODE=python

# ---------- AI (Gemini) ----------
# Paste your key(s). Without a key Step 3 always returns HOLD.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
# ... more? GEMINI_API_KEY_7 ... _20 are read automatically.
# Quota counts per Google Cloud PROJECT, not per key: keys from DIFFERENT
# Gmail accounts / projects add real daily capacity; same-project keys
# share one pool. The bot rotates and cools down a busy key automatically.

# ---------- optional future providers (unused now) ----------
DATABENTO_API_KEY=
RITHMIC_USERNAME=
RITHMIC_PASSWORD=

# ===================== POSITION MANAGER (v4) =====================
# The robot now MANAGES open positions: structural SL/TP (order blocks /
# POC / round numbers), break-even, trailing, early exits. 0 = old
# open-and-forget behaviour.
PM_ENABLE=1
# Move SL to break-even once profit reaches this multiple of initial risk
PM_BE_TRIGGER_R=1.0
# Trail the SL behind fresh structure (tighten only, never widen)
PM_TRAIL_ENABLE=1
# Close early when the signal flips this hard against the position (0-100)
PM_FLIP_EXIT_SCORE=55
# Flip exit requires order flow agreement (1) or fires on score alone (0)
PM_FLIP_REQUIRE_FLOW=1
# Close when CVD diverges against the position while it is still early
PM_DIVERGENCE_EXIT=1
# Close positions older than N minutes that travelled < P of the TP leg
PM_TIME_STOP_MINUTES=90
PM_TIME_STOP_MIN_PROGRESS=0.2
# Structural SL distance clamps in ATR multiples (fixes "SL too far")
PM_MIN_SL_ATR=1.2
PM_MAX_SL_ATR=3.0
# SL buffer beyond a zone / TP buffer in front of opposing structure (xATR)
PM_ZONE_BUFFER_ATR=0.25
PM_TP_BUFFER_ATR=0.15
# Clearance from strong round numbers (x00/x50) — hunt protection (xATR)
PM_ROUND_HUNT_BUFFER_ATR=0.12
# TP distance clamps in ATR multiples
PM_TP_MIN_ATR=1.0
PM_TP_MAX_ATR=4.0
# Minimum seconds between SL/TP modifications of the same position
PM_MODIFY_COOLDOWN_SECONDS=180

# ------------- v4.1 in-trade intelligence (all optional) -------------
# H1/H4 Points of Control join the SL/TP anchor pool
PM_HTF_POC_ENABLE=1
# Footprint stacked-imbalance clusters act as fresh zones
# (one side must dominate by this ratio over N consecutive prices)
PM_FP_ZONES_ENABLE=1
PM_FP_IMB_RATIO=3.0
PM_FP_MIN_RUN=3
# Flow health: price moves in our favour but CVD disagrees ->
# break-even trigger drops to this R multiple (protect early)
PM_FLOW_ENABLE=1
PM_FLOW_LOOKBACK_MINUTES=5
PM_FLOW_WEAK_BE_R=0.5
# VWAP regime: trail behind VWAP on trend days, lock half the gain
# when stretched, use VWAP as TP magnet on range days
PM_VWAP_ENABLE=1
PM_VWAP_TREND_Z=0.5
PM_VWAP_STRETCH_Z=2.0
PM_VWAP_TRAIL_BUFFER_ATR=0.25

# How many MB of ticks.csv to re-read at robot startup (deeper history =
# ATR / MTF / order blocks / H1-H4 POC work immediately after restart)
NT_CATCHUP_MB=64

# ------------- v4.2 risk perimeter -------------
# Protect positions around HIGH-impact events (CPI, NFP, FOMC):
#   tighten = lock gains on profitable positions (default)
#   flatten = close everything before the release
PM_NEWS_PROTECT_ENABLE=1
PM_NEWS_PROTECT_MINUTES=10
PM_NEWS_PROTECT_MODE=tighten
# Close ALL bot positions daily at this UTC time, BEFORE the XAUUSD CFD
# break (~22:00 UTC) — a gap can jump straight over a stop. Also covers
# the weekend (Friday). Set to empty (PM_DAILY_FLATTEN_UTC=) to disable.
PM_DAILY_FLATTEN_UTC=21:30
# Never donate the spread: postpone SL/TP edits and non-urgent closes
# while the CFD spread exceeds this percentage (news-second spikes)
PM_ACTION_MAX_SPREAD_PCT=0.05

# ------------- v4.3 profit protection -------------
# Profit ratchet: once the open gain reaches this many ATRs (in price
# points), the SL NEVER gives back more than PM_PROFIT_GIVEBACK of the
# best gain seen — winners close as winners
PM_PROFIT_LOCK_ENABLE=1
PM_PROFIT_LOCK_MIN_ATR=1.0
PM_PROFIT_GIVEBACK=0.5
# Momentum exit: a profitable position closes AT MARKET when flow health
# says "flow against the position" AND the signal turns against it with
# at least this strength (softer than the 55 flip exit)
PM_MOMENTUM_EXIT_ENABLE=1
PM_MOMENTUM_MIN_R=0.3
PM_MOMENTUM_SIGNAL=40
